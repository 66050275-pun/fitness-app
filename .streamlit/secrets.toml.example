# Copy these settings into FITNESS-APP's Streamlit Cloud Secrets.
# Never commit the actual .streamlit/secrets.toml or put the key in VITE_* variables.
MAXPLUS_API_KEY = "replace-with-your-maxplus-key"
MAXPLUS_MODEL = "replace-with-an-image-capable-model-id"
MAXPLUS_BASE_URL = "https://api.maxplus-ai.cc/v1"

# Owner-key scan attempts per Bangkok calendar day in this server process.
# The counter resets on process restart. Set provider-side spending limits too.
MAXPLUS_DAILY_SCAN_LIMIT = 20

# Optional: restrict AI usage to people who know this separate service access code.
# This is NOT the user's private vault PIN. Use at least 16 characters.
# MAXPLUS_ACCESS_CODE = "replace-with-a-random-service-access-code"

# Optional custom processing notices: supply BOTH languages together.
# MAXPLUS_PHOTO_NOTICE_EN = "Your accurate photo-processing and provider-retention notice."
# MAXPLUS_PHOTO_NOTICE_TH = "ข้อความแจ้งการส่งภาพและการเก็บข้อมูลของผู้ให้บริการที่ถูกต้อง"
